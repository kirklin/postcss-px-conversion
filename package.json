{
  "name": "postcss-px-conversion",
  "type": "module",
  "version": "0.1.4",
  "packageManager": "pnpm@12.11.2",
  "description": "PostCSS plugin that converts px to viewport units, px to rem, rem to px and px to rpx",
  "author": "Kirk Lin <https://github.com/kirklin>",
  "license": "MIT",
  "funding": "https://www.buymeacoffee.com/linkirk",
  "homepage": "https://github.com/kirklin/postcss-px-conversion#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kirklin/postcss-px-conversion.git"
  },
  "bugs": "https://github.com/kirklin/postcss-px-conversion/issues",
  "keywords": [
    "postcss",
    "postcss-plugin",
    "px",
    "vw",
    "viewport",
    "rem",
    "rpx",
    "px-to-viewport",
    "pxtorem",
    "rem-to-px"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "play": "pnpm -C playground dev",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prepublishOnly": "pnpm build",
    "release": "bumpp",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:ts6": "tsc6 --noEmit",
    "prepare": "simple-git-hooks",
    "up": "taze latest -r -w -I"
  },
  "peerDependencies": {
    "postcss": "^8.0.0"
  },
  "devDependencies": {
    "@antfu/ni": "catalog:cli",
    "@kirklin/eslint-config": "catalog:cli",
    "@types/node": "catalog:types",
    "@typescript/native": "catalog:cli",
    "bumpp": "catalog:cli",
    "eslint": "catalog:cli",
    "eslint-plugin-erasable-syntax-only": "catalog:cli",
    "eslint-plugin-format": "catalog:cli",
    "lint-staged": "catalog:cli",
    "postcss": "catalog:testing",
    "simple-git-hooks": "catalog:cli",
    "taze": "catalog:cli",
    "typescript": "catalog:cli",
    "unbuild": "catalog:cli",
    "vitest": "catalog:testing"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm i --frozen-lockfile --ignore-scripts --offline && pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
